{
  "name": "reto-cafeteria-cypress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:test": "cross-env NODE_ENV=test node server.js",
    "dev": "node --watch server.js",
